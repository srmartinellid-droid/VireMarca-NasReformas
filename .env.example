# ======================== DATABASE (Neon PostgreSQL) ========================
# Create a free project at https://neon.tech
# Copy the connection string (use the pooled one for serverless)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/nascimento?sslmode=require

# ======================== AUTH ========================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Admin bootstrap (used only on first seed)
ADMIN_EMAIL=admin@nascimentoreformas.com.br
ADMIN_PASSWORD=change-me-on-first-login

# ======================== STORAGE (Vercel Blob) ========================
# Create token at Vercel Dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# ======================== SITE ========================
NEXT_PUBLIC_SITE_URL=https://nascimentoreformas.com.br
NEXT_PUBLIC_WHATSAPP=554892056761
NEXT_PUBLIC_SITE_NAME=Nascimento Reformas

# ======================== ANALYTICS (optional) ========================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXX
